# Public — safe in the browser bundle, RLS-gated. Committed in .env so the
# Vercel build works, but set these in Vercel → Settings → Environment
# Variables too so the build stops depending on a committed file.
NEXT_PUBLIC_SUPABASE_PROJECT_ID=
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=

# SERVER ONLY — never prefix with NEXT_PUBLIC_, never commit a real value.
# This key BYPASSES Row Level Security. Set it only in Vercel (Production +
# Preview) and, for local dev, in .env.local (which is gitignored).
SUPABASE_SECRET_KEY=
